# Em Render -> Web Service -> Environment, preencha estes valores.
# Valores da configuração WEB do aplicativo no Firebase (não são a chave privada).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
# Credenciais PRIVADAS do Firebase Admin SDK: JSON inteiro em uma única variável.
# Nunca coloque o JSON no GitHub ou em arquivos públicos.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# Opcional: alternativa LOCAL ao JSON acima: GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/chave.json
CSRF_SECRET=gere-uma-string-aleatoria-longa-para-producao
NODE_ENV=production
