<%- include('../partials/header') %>
<header class="page-header">
  <div><a class="back-link" href="/tickets"><%- icon('back', 16) %> Chamados</a><div class="title-line"><span class="ticket-code lg"><%= ticket.protocolo %></span><span class="status status-<%= ticket.status === 'Resolvido' ? 'green' : ticket.status === 'Em Atendimento' ? 'amber' : 'blue' %>"><%= ticket.status %></span><span class="badge badge-blue"><%= ticket.prioridade %></span></div><h1><%= ticket.titulo %></h1><p class="subtitle">Aberto em <%= formatDate(ticket.criadoEm) %> por <%= ticket.autorNome %></p></div>
  <% if (isAdmin) { %><div class="header-actions"><a class="btn btn-secondary" href="/tickets/<%= ticket.id %>/edit"><%- icon('edit', 16) %> Editar</a><form method="post" action="/tickets/<%= ticket.id %>/delete" data-confirm="Excluir definitivamente este chamado?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger" type="submit"><%- icon('trash', 16) %> Excluir</button></form></div><% } %>
</header>
<div class="detail-layout"><div class="detail-main">
  <section class="card"><h2 class="form-section"><%- icon('message') %> Descrição</h2><div class="description"><%= ticket.descricao %></div></section>
  <section class="card"><h2 class="form-section"><%- icon('clock') %> Histórico e comentários</h2>
    <ol class="timeline">
      <% (ticket.historico || []).slice().sort((a,b) => new Date(a.data)-new Date(b.data)).forEach(h => { %>
        <li class="tl-item tl-comment"><span class="tl-dot"></span><div class="bubble"><div class="bubble-head"><strong><%= h.autorNome %></strong><time class="muted"><%= formatDate(h.data) %></time></div><p><%= h.texto %></p></div></li>
      <% }) %>
    </ol>
    <form method="post" action="/tickets/<%= ticket.id %>/comentarios" class="comment-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="comentario">Adicionar comentário</label><textarea id="comentario" name="comentario" maxlength="2000" required placeholder="Escreva seu comentário..."></textarea></div><button class="btn btn-secondary" type="submit">Enviar comentário</button></form>
  </section>
</div><aside class="detail-side">
  <section class="card"><h2 class="form-section"><%- icon('user') %> Informações</h2><dl class="info-list"><div><dt>Solicitante</dt><dd><%= ticket.autorNome %></dd></div><div><dt>E-mail</dt><dd><%= ticket.autorEmail %></dd></div><div><dt>Categoria</dt><dd><%= ticket.categoria %></dd></div><div><dt>Setor</dt><dd><%= ticket.setor || 'Não informado' %></dd></div><div><dt>Técnico responsável</dt><dd><%= ticket.tecnicoResponsavel ? ticket.tecnicoResponsavel.nome : 'Não atribuído' %></dd></div></dl></section>
  <% if (ticket.parecerTecnico) { %><section class="card"><h2 class="form-section">Parecer técnico</h2><p class="description"><%= ticket.parecerTecnico %></p></section><% } %>
  <% if (canAttend) { %>
  <section class="card"><h2 class="form-section"><%- icon('activity') %> Atendimento técnico</h2><form method="post" action="/tickets/<%= ticket.id %>/atender"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="status">Status</label><select name="status" id="status"><% STATUSES.forEach(s => { %><option value="<%= s %>" <%= ticket.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div><div class="field"><label for="parecer">Parecer técnico</label><textarea name="parecer" id="parecer" maxlength="2000" placeholder="Ações realizadas, diagnóstico e solução..."></textarea></div><button type="submit" class="btn btn-primary btn-block">Assumir / atualizar chamado</button></form></section>
  <% } %>
</aside></div>
<%- include('../partials/footer') %>
