<% if (!tickets.length) { %>
  <div class="empty"><%- icon('inbox', 36) %><h3>Nenhum chamado encontrado</h3><p>Abra seu primeiro chamado de TI ou ajuste os filtros.</p><a href="/tickets/new" class="btn btn-primary">Novo chamado</a></div>
<% } else { %>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Protocolo</th><th>Chamado</th><th>Prioridade</th><th>Status</th><th>Responsável</th><th>Aberto em</th></tr></thead>
  <tbody>
    <% tickets.forEach(t => { %>
    <tr data-href="/tickets/<%= t.id %>">
      <td><a href="/tickets/<%= t.id %>" class="ticket-code"><%= t.protocolo %></a></td>
      <td class="cell-main"><a href="/tickets/<%= t.id %>"><strong><%= t.titulo %></strong></a><span class="muted"><%= t.autorNome %> · <%= t.categoria %></span></td>
      <td><span class="badge badge-<%= t.prioridade === 'Crítica' ? 'red' : t.prioridade === 'Alta' ? 'amber' : 'blue' %>"><%= t.prioridade %></span></td>
      <td><span class="status status-<%= t.status === 'Resolvido' ? 'green' : t.status === 'Em Atendimento' ? 'amber' : 'blue' %>"><%= t.status %></span></td>
      <td class="muted"><%= t.tecnicoResponsavel ? t.tecnicoResponsavel.nome : 'Não atribuído' %></td>
      <td class="nowrap muted"><%= formatDate(t.criadoEm) %></td>
    </tr>
    <% }) %>
  </tbody>
</table></div>
<% } %>
