<%- include('../partials/header') %>
<header class="page-header"><div><p class="eyebrow">Suporte técnico</p><h1>Chamados</h1><p class="subtitle"><%= tickets.length %> resultado(s). <%= currentUser.perfil === 'user' ? 'Somente seus chamados são exibidos.' : 'Você pode visualizar a fila completa.' %></p></div><a href="/tickets/new" class="btn btn-primary"><%- icon('plus') %> Novo chamado</a></header>
<nav class="tabs" aria-label="Filtro de status">
  <a href="/tickets" class="tab <%= !filtros.status ? 'active' : '' %>">Todos</a>
  <% STATUSES.forEach(s => { %><a href="/tickets?status=<%= encodeURIComponent(s) %>" class="tab <%= filtros.status === s ? 'active' : '' %>"><%= s %></a><% }) %>
</nav>
<form method="get" action="/tickets" class="card filters"><div class="search"><%- icon('search') %><input type="search" name="q" value="<%= filtros.q %>" placeholder="Título, solicitante, protocolo…" aria-label="Buscar chamados"></div><input type="hidden" name="status" value="<%= filtros.status %>"><button class="btn btn-secondary" type="submit">Buscar</button></form>
<section class="card card-flush"><%- include('_table', { tickets }) %></section>
<%- include('../partials/footer') %>
