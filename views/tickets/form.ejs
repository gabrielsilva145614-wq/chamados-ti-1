<%- include('../partials/header') %>
<header class="page-header"><div><a href="<%= isEdit ? '/tickets/' + ticket.id : '/tickets' %>" class="back-link"><%- icon('back', 16) %> Voltar aos chamados</a><h1><%= isEdit ? 'Editar chamado' : 'Abrir novo chamado' %></h1><p class="subtitle"><%= isEdit ? 'Administre os dados do registro.' : 'Descreva seu problema para que nossa equipe possa ajudar.' %></p></div></header>
<% if (errors.length) { %><div class="alert alert-error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
<form method="post" action="<%= isEdit ? '/tickets/' + ticket.id + '/edit' : '/tickets' %>" class="form-layout">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="card">
    <h2 class="form-section"><%- icon('ticket') %> Detalhes do chamado</h2>
    <div class="field"><label for="titulo">Título <span class="req">*</span></label><input type="text" id="titulo" name="titulo" minlength="3" maxlength="150" value="<%= ticket.titulo || '' %>" placeholder="Ex.: Computador não liga" required></div>
    <div class="field"><label for="descricao">Descrição <span class="req">*</span></label><textarea id="descricao" name="descricao" rows="7" minlength="5" maxlength="5000" required placeholder="O que aconteceu? Desde quando? Apareceu alguma mensagem de erro?"><%= ticket.descricao || '' %></textarea></div>
    <div class="field-row">
      <div class="field"><label for="categoria">Categoria</label><select name="categoria" id="categoria"><% CATEGORIES.forEach(c => { %><option value="<%= c %>" <%= (ticket.categoria || 'Outros') === c ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
      <div class="field"><label for="setor">Setor</label><input id="setor" name="setor" type="text" maxlength="60" placeholder="Ex.: Financeiro" value="<%= ticket.setor || '' %>"></div>
    </div>
    <div class="field"><label for="prioridade">Prioridade</label><select name="prioridade" id="prioridade"><% PRIORITIES.forEach(p => { %><option value="<%= p %>" <%= (ticket.prioridade || 'Média') === p ? 'selected' : '' %>><%= p %></option><% }) %></select></div>
  </section>
  <aside class="card">
    <h2 class="form-section"><%- icon('user') %> Solicitante</h2>
    <div class="field"><label>Nome</label><strong><%= isEdit ? ticket.autorNome : currentUser.nome %></strong></div>
    <div class="field"><label>E-mail</label><span class="muted"><%= isEdit ? ticket.autorEmail : currentUser.email %></span></div>
    <p class="muted">O solicitante é identificado pela conta autenticada. O status inicial será <strong>Aberto</strong>.</p>
    <div class="form-actions"><button class="btn btn-primary btn-block" type="submit"><%= isEdit ? 'Salvar alterações' : 'Abrir chamado' %></button><a class="btn btn-ghost btn-block" href="/tickets">Cancelar</a></div>
  </aside>
</form>
<%- include('../partials/footer') %>
