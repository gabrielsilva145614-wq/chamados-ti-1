<%- include('partials/header') %>
<header class="page-header">
  <div>
    <p class="eyebrow">Bem-vindo(a), <%= currentUser.nome %></p>
    <h1>Painel de chamados</h1>
    <p class="subtitle"><%= currentUser.perfil === 'user' ? 'Acompanhe seus pedidos de suporte.' : 'Acompanhe a fila de atendimento.' %></p>
  </div>
  <a href="/tickets/new" class="btn btn-primary"><%- icon('plus') %> Abrir chamado</a>
</header>
<section class="stats" aria-label="Indicadores">
  <a href="/tickets" class="stat-card stat-indigo"><span class="stat-icon"><%- icon('inbox', 22) %></span><span class="stat-label">Total</span><span class="stat-value" data-count="<%= total %>"><%= total %></span><span class="stat-foot"><%= currentUser.perfil === 'user' ? 'seus chamados' : 'chamados registrados' %></span></a>
  <a href="/tickets?status=Aberto" class="stat-card stat-red"><span class="stat-icon"><%- icon('alert', 22) %></span><span class="stat-label">Abertos</span><span class="stat-value" data-count="<%= counts['Aberto'] %>"><%= counts['Aberto'] %></span><span class="stat-foot">aguardando atendimento</span></a>
  <a href="/tickets?status=Em%20Atendimento" class="stat-card stat-amber"><span class="stat-icon"><%- icon('activity', 22) %></span><span class="stat-label">Em atendimento</span><span class="stat-value" data-count="<%= counts['Em Atendimento'] %>"><%= counts['Em Atendimento'] %></span><span class="stat-foot">em andamento</span></a>
  <a href="/tickets?status=Resolvido" class="stat-card stat-green"><span class="stat-icon"><%- icon('check', 22) %></span><span class="stat-label">Resolvidos</span><span class="stat-value" data-count="<%= counts['Resolvido'] %>"><%= counts['Resolvido'] %></span><span class="stat-foot">atendimentos finalizados</span></a>
</section>
<section class="card card-flush"><div class="card-head pad-head"><h2>Chamados recentes</h2><a href="/tickets" class="btn btn-ghost">Ver todos</a></div><%- include('tickets/_table', { tickets: recentes }) %></section>
<%- include('partials/footer') %>
