
<%- include('partials/header') %>

<% const code = error && error.status ? error.status : 500; %>

<div class="card empty page-empty">
  <span class="big-code"><%= code %></span>

  <h1><%= code === 403 ? 'Acesso negado' : 'Algo deu errado' %></h1>

  <p>
    <%= code === 403
      ? 'Você não tem permissão para acessar esta página.'
      : 'Ocorreu um erro inesperado ao processar sua solicitação.' %>
  </p>

  <pre class="error-detail"><%= error && error.message %></pre>

  <a href="/" class="btn btn-primary" id="error-home">
    <%- icon('back', 16) %> Voltar ao dashboard
  </a>
</div>

<%- include('partials/footer') %>