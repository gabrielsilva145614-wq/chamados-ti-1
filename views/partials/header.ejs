<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · HelpDesk TI</title>
  <meta name="description" content="Central de chamados de TI com acesso por perfil">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script id="firebase-web-config" type="application/json"><%- firebaseConfigJson %></script>
</head>
<body>
  <div class="bg-glow" aria-hidden="true"></div>
  <div class="app">
    <aside class="sidebar">
      <a href="/" class="brand"><span class="brand-logo"><%- icon('zap', 20) %></span><span class="brand-text">HelpDesk<strong>TI</strong></span></a>
      <nav class="nav" aria-label="Navegação principal">
        <span class="nav-label">Geral</span>
        <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>"><%- icon('dashboard') %> Dashboard</a>
        <a href="/tickets" class="nav-link <%= currentPath.startsWith('/tickets') ? 'active' : '' %>"><%- icon('ticket') %> Chamados</a>
        <% if (isAdmin) { %>
          <span class="nav-label">Administração</span>
          <a href="/usuarios" class="nav-link <%= currentPath.startsWith('/usuarios') ? 'active' : '' %>"><%- icon('users') %> Gestão de usuários</a>
        <% } %>
      </nav>
      <a href="/tickets/new" class="btn btn-primary btn-block sidebar-cta"><%- icon('plus') %> Novo chamado</a>
      <div class="sidebar-account">
        <strong><%= currentUser.nome %></strong>
        <span class="muted"><%= currentUser.email %></span>
        <span class="badge badge-purple">Perfil: <%= currentUser.perfil %></span>
        <form method="post" action="/auth/logout">
          <button type="submit" class="btn btn-secondary btn-block">Sair da conta</button>
        </form>
      </div>
    </aside>
    <main class="main">
      <div class="account-topbar"><span>Conectado como <strong><%= currentUser.nome %></strong></span><span class="badge badge-purple"><%= currentUser.perfil %></span></div>
      <% if (msg) { %><div class="toast toast-success" role="status" data-toast><%- icon('check') %><span><%= msg %></span><button type="button" class="toast-close" aria-label="Fechar" data-toast-close><%- icon('x', 16) %></button></div><% } %>
      <% if (erro) { %><div class="toast toast-error" role="alert" data-toast><%- icon('alert') %><span><%= erro %></span><button type="button" class="toast-close" aria-label="Fechar" data-toast-close><%- icon('x', 16) %></button></div><% } %>
