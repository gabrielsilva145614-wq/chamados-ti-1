rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore só é acessado pelo servidor via Firebase Admin SDK.
    // Admin SDK usa credencial de serviço e ignora estas regras de cliente.
    // Assim nem usuários autenticados conseguem alterar perfis ou chamados diretamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
